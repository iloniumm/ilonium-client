include HtmlMakefile

SUBDIRS = net

# almost all possilbe automatically generated HTML files should be considered documentation
doc_html_files=$(filter-out navbar.html head.html, $(auto_html_files))

doc_txt_files=commands.txt COPYING.txt Content_Creation/Howto-Maps.txt
docfiles=$(doc_txt_files) $(doc_html_files)

COPYING.txt:
	cp ${top_srcdir}/COPYING $@

# autogenerate commands.txt from executable
if BUILDFAKERELEASE
commands.html.post: commands.html
	if test "`grep 'Running FAKE' $(srcdir)/commands.txt`" != ""; then touch -t 198001010000 $(srcdir)/commands.txt; fi

all-local: commands.html.post
endif

# The list of every console setting used to be regenerated by running the game
# that had just been built, in the middle of the build, whenever anything in
# language/ changed. It is a windowed program: on a machine with a screen it
# prints its list and stops, and on a build machine without one it starts and
# waits, and the build waits with it - after the last file had compiled and the
# program had linked, with nothing on screen to say what was being waited for.
#
# The file is kept in the tree instead. It is written by hand from a run on a
# real machine, which is the only place the program can be asked anything.
$(srcdir)/commands.txt:
	test -r $@ || echo "Sorry, command help generation failed." > $@

# Asks the game for the list. For somebody with a screen, on purpose.
commands-txt-refresh:
	cd $(top_builddir)/src && $(MAKE) armagetronad_main$(EXEEXT) && cd .. && ./src/armagetronad_main$(EXEEXT) --vardir ./rubbish --doc 2>&1 | sed -e "s,^\[0\] ,," | grep -v "_help$$" | grep -v "^changed" | grep -v "^Executable path: " | grep -v "^TestPath" | grep -v "^Testing data path: " | grep -v "^Testing configuration path: " | grep -v "^Closing socket" | grep -v "^Locale item" > $(srcdir)/commands.txt

.PHONY: commands-txt-refresh

print:
	echo $(auto_html_files_m4_dist)

# install generated html files and put them directly into the distribution
textdir=$(armadocdir)
text_DATA=$(doc_txt_files)

htmldir=$(armadocdir)/html
html_DATA=$(doc_html_files)
distclean-local:
	rm -f COPYING.txt

dist-hook: htmldist-hook ${srcdir}/commands.txt ${docfiles}
	cp ${srcdir}/commands.txt $(distdir)
	cp -R ${srcdir}/Content_Creation $(distdir)
	cp -R ${doc_html_files} $(distdir)

# make target for testing documentation without installing
localtest: all Howto-Maps.txt ${docfiles}

Howto-Maps.txt:
	ln -s ${srcdir}/Content_Creation/$@ $@
